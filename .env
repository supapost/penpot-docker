# Penpot @ penpot.increstive.co.th — environment variables
# Set these in Coolify → your Penpot resource → Environment Variables.
# Coolify auto-detects every ${VAR} referenced in docker-compose.yaml and shows it here.

# --- Image version (pin to the 2.18 minor; bump deliberately, never to "latest") ---
PENPOT_VERSION=2.18

# --- Master secret key (generated; KEEP STABLE forever — changing it logs everyone
#     out and breaks every pending email-verification link) ---
PENPOT_SECRET_KEY=vGORL368wEa0J01mZNRtcJAsmaurwoQG-VXAO9ahYpYOJh6to1DNbTD093m9Wfuhs2DG5s9REtw3R4hzLrkbjw

# --- Postgres password (generated; used by both the postgres container and the backend) ---
POSTGRES_PASSWORD=Ji2giqmN9iVRza7FRmW2YC1rgkNIZ3dU

# --- Postmark: the Server API Token. Goes into BOTH SMTP username and password. ---
POSTMARK_SERVER_TOKEN=replace-with-your-postmark-server-token

# --- DigitalOcean Spaces (sgp1) access key for bucket inc-penpot-contents ---
AWS_ACCESS_KEY_ID=replace-with-your-spaces-access-key-id
AWS_SECRET_ACCESS_KEY=replace-with-your-spaces-secret-access-key
